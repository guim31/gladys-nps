{
  "manifest_version": 1,
  "type": "device",
  "name": "US National Parks",
  "description": {
    "en": "Alerts, closures and events of the US national parks you follow (Yosemite, Yellowstone…).",
    "fr": "Alertes, fermetures et événements des parcs nationaux américains suivis (Yosemite, Yellowstone…).",
    "de": "Warnungen, Schließungen und Veranstaltungen der US-Nationalparks, die du verfolgst (Yosemite…).",
    "es": "Alertas, cierres y eventos de los parques nacionales de EE. UU. que sigue (Yosemite, Yellowstone…)."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-nps:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-nps/main/cover.png",
  "categories": ["leisure", "environment"],
  "transports": ["cloud"],
  "countries": ["US"],
  "keywords": [
    "National Park Service",
    "NPS",
    "national park",
    "parc national",
    "Nationalpark",
    "parque nacional",
    "Yosemite",
    "Yellowstone",
    "Grand Canyon",
    "alerts"
  ],
